# Puerto del servidor.
# SERVER_PORT manda sobre PORT (el panel del hosting define SERVER_PORT, ej. 25545).
# SERVER_PORT=25545
PORT=3000

# API de OrbitX Space (TikTok, Pinterest y búsqueda de YouTube de respaldo)
ORBITX_BASE_URL=https://api.orbitxspace.com
ORBITX_API_KEY=tu_api_key_aqui

# Descargas simultáneas (protege el servidor)
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_PER_IP=2

# Dominios extra permitidos en /api/proxy y /api/media (separados por coma).
# Los de YouTube, TikTok, Pinterest y savenow ya vienen incluidos.
# ALLOWED_HOSTS=ejemplo.com,cdn.ejemplo.com
